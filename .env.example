# Copy to .env.local (and create the same file on the server).
# NEXT_PUBLIC_* values are baked in at build time -> rebuild after changing them.
# SMTP_* / CONTACT_TO are read at runtime -> only `pm2 restart buildwebs-eu` is needed.

# Google Analytics 4 measurement id (loads only after cookie consent), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification code
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Calendly (or similar) link; shows "Book a call" buttons when set
NEXT_PUBLIC_BOOKING_URL=

# Contact form delivery: mailbox at lh.pl
SMTP_HOST=mail-serwer182945.lh.pl
SMTP_PORT=465
SMTP_USER=contact@buildwebs.eu
# Put the password in double quotes if it contains # or $ (otherwise the .env parser cuts it)
SMTP_PASS=""
# Where enquiries are delivered (defaults to SMTP_USER)
CONTACT_TO=contact@buildwebs.eu
